# Copy to .env. Demo path 1–6 works without these.
# Strands desk agent needs Bedrock model access.

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Claude Sonnet on Bedrock. Override if your account uses another inference profile.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Set to 1 to force the deterministic desk even if AWS creds exist.
MARKMAP_DISABLE_BEDROCK=0

MARKMAP_SECRET=change-me-before-you-deploy
MARKMAP_STORE=data/markmap.json
PORT=8080
