# Copy to .env. Run desk always goes through a Strands Agent.
# Without keys, the scripted local model calls the same tools.

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Claude Sonnet on Bedrock. Override if your account uses another inference profile.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# scripted | ollama | mlx | bedrock
# mlx    = LM Studio / oMLX / any OpenAI-compatible local server
# ollama = local Ollama on :11434
# bedrock= Amazon Bedrock (requires AWS to authorize invoke — see README)
MARKMAP_DESK_MODEL=mlx
MARKMAP_OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434
# LM Studio: Developer → Local Server → Start, then:
MARKMAP_MLX_BASE_URL=http://192.168.31.64:1234/v1
MARKMAP_MLX_MODEL=qwen2.5-coder-7b-instruct-mlx@8bit

# Set to 1 to skip Bedrock even if AWS creds exist.
MARKMAP_DISABLE_BEDROCK=1

MARKMAP_SECRET=change-me-before-you-deploy
MARKMAP_STORE=data/markmap.json
PORT=8080

# Set to production only on App Runner / a public host (requires a non-default MARKMAP_SECRET).
# MARKMAP_ENV=production
# MARKMAP_SECURE_COOKIE=1
